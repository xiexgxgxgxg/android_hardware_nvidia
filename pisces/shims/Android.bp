// Legacy compatibility shims for pre-Android-7 Tegra blobs.
cc_library_shared {
    name: "libshim_atomic",
    srcs: [
        "shim_atomic.c",
        "shim_graphicbuffer.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libui",
    ],
    cflags: [
        "-fno-builtin",
        // Soong hides symbols by default; the blobs dlopen later and need
        // these in the dynamic symbol table.
        "-fvisibility=default",
    ],
    cppflags: ["-std=c++14"],
}

// The 2013 tegra camera HAL needs the Android 4.x SensorManager entry points.
// LD_PRELOADed into the camera provider so the vendor module can resolve them
// (hw_get_module loads it in a linker namespace where RTLD_GLOBAL does not
// reach).  It forwards to the real Android 9 SensorManager/SensorEventQueue.
cc_library_shared {
    name: "libpisces_camshim",
    srcs: [
        "camshim.cpp",
    ],
    cflags: [
        "-fvisibility=default",
        "-fno-builtin",
    ],
    cppflags: ["-std=c++14"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "libsensor",
        "libutils",
    ],
}

// Spreadtrum RIL blob needs the pre-M libcutils socket_loopback_client().
cc_library_shared {
    name: "libpisces_rilshim",
    srcs: [
        "rishim.c",
    ],
    cflags: [
        "-fvisibility=default",
        "-fno-builtin",
    ],
}
