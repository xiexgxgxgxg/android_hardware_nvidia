// Legacy atomics for pre-Android-7 Tegra blobs (hwcomposer.tegra, gralloc.tegra).
cc_library_shared {
    name: "libshim_atomic",
    srcs: ["shim_atomic.c"],
    cflags: [
        "-fno-builtin",
        // Soong hides symbols by default; the blobs dlopen into the
        // composer service and need these in the dynamic symbol table.
        "-fvisibility=default",
    ],
}
