cc_binary {
    name: "android.hardware.graphics.mapper@2.0-service",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    init_rc: ["android.hardware.graphics.mapper@2.0-service.rc"],
    shared_libs: [
        "android.hardware.graphics.mapper@2.0",
        "libbase",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
}
